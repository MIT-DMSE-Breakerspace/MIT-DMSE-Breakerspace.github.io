#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 3 || $# -gt 5 ]]; then
  echo "Usage: script/convert-instructional-media SOURCE_MEDIA OUTPUT_DIRECTORY OUTPUT_STEM [MAX_WIDTH] [POSTER_TIME]" >&2
  exit 2
fi

source_media="$1"
output_directory="$2"
output_stem="$3"
max_width="${4:-1280}"
poster_time="${5:-1}"

if [[ ! -f "$source_media" ]]; then
  echo "Source media not found: $source_media" >&2
  exit 1
fi

if [[ ! "$output_stem" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "Output stem must use lowercase letters, numbers, and single hyphens: $output_stem" >&2
  exit 2
fi

if [[ ! "$max_width" =~ ^[0-9]+$ ]] || (( max_width < 2 || max_width % 2 != 0 )); then
  echo "Maximum width must be a positive even integer: $max_width" >&2
  exit 2
fi

if [[ ! "$poster_time" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "Poster time must be zero or a positive number of seconds: $poster_time" >&2
  exit 2
fi

for required_command in ffmpeg ffprobe; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    echo "$required_command is required to convert instructional media." >&2
    exit 1
  fi
done
mkdir -p "$output_directory"

mp4_output="$output_directory/$output_stem.mp4"
webm_output="$output_directory/$output_stem.webm"
poster_output="$output_directory/$output_stem-poster.jpg"
production_dimensions="scale='trunc(min(iw,$max_width)/2)*2':-2:flags=lanczos"

ffmpeg -y -hide_banner -loglevel error \
  -i "$source_media" \
  -an \
  -vf "$production_dimensions" \
  -c:v libx264 \
  -preset slow \
  -crf 24 \
  -pix_fmt yuv420p \
  -movflags +faststart \
  -map_metadata -1 \
  "$mp4_output"

ffmpeg -y -hide_banner -loglevel error \
  -i "$source_media" \
  -an \
  -vf "$production_dimensions" \
  -c:v libvpx-vp9 \
  -crf 32 \
  -b:v 0 \
  -deadline good \
  -cpu-used 2 \
  -row-mt 1 \
  -pix_fmt yuv420p \
  -map_metadata -1 \
  "$webm_output"

ffmpeg -y -hide_banner -loglevel error \
  -ss "$poster_time" \
  -i "$source_media" \
  -frames:v 1 \
  -vf "$production_dimensions" \
  -q:v 3 \
  -map_metadata -1 \
  "$poster_output"

for output_file in "$mp4_output" "$webm_output" "$poster_output"; do
  if [[ ! -s "$output_file" ]]; then
    echo "Conversion did not produce a usable file: $output_file" >&2
    exit 1
  fi
done

ffprobe -v error \
  -select_streams v:0 \
  -show_entries stream=width,height,avg_frame_rate \
  -show_entries format=duration \
  -of default=noprint_wrappers=1 \
  "$mp4_output"
