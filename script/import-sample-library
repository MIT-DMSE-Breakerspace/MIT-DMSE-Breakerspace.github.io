#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "open3"
require "pathname"
require "tmpdir"
require "yaml"

class ImportError < StandardError; end

ROOT = File.expand_path(ENV.fetch("SAMPLE_LIBRARY_SITE_ROOT", File.expand_path("..", __dir__)))
IMAGE_EXTENSIONS = %w[.bmp .jpeg .jpg .png .tif .tiff .webp].freeze
JPEG_QUALITIES = [82, 78, 74, 70, 65, 60, 55, 50].freeze
SAMPLE_LIBRARY_IMAGE_MAX_BYTES = 1024 * 1024
SUPPORTED_SCHEMA_VERSIONS = [1, 2, 3].freeze
ROOT_KEYS = %w[schemaVersion exportId generatedAt samples].freeze
SAMPLE_KEYS = {
  1 => %w[publicId updatedAt fields availability specimens assets],
  2 => %w[publicId updatedAt fields availability specimens assets microscopy],
  3 => %w[publicId updatedAt fields availability specimens assets]
}.freeze
FIELD_KEYS = %w[name description materialClass composition physicalForm provenance preparationNotes handlingNotes storageRequirements].freeze
SPECIMEN_KEYS = %w[labelId status location].freeze
ASSET_KEYS = {
  1 => %w[assetId packagePath contentType kind caption instrument sha256 sizeBytes],
  2 => %w[assetId packagePath contentType kind caption instrument sha256 sizeBytes],
  3 => %w[assetId packagePath contentType kind caption instrument observationMode fieldWidth sha256 sizeBytes]
}.freeze
MICROSCOPY_KEYS = %w[assetId fields].freeze
MICROSCOPY_FIELD_DEFINITIONS = {
  "instrumentModel" => ["instrument-model", "Instrument", "Equipment"],
  "cameraName" => ["camera-name", "Camera", "Equipment"],
  "captureDate" => ["capture-date", "Capture date", "Equipment"],
  "imageDimensions" => ["image-dimensions", "Image dimensions", "Image and scale"],
  "pixelPitch" => ["pixel-pitch", "Pixel pitch", "Image and scale"],
  "fieldOfView" => ["field-of-view", "Field of view", "Image and scale"],
  "observationMethod" => ["observation-method", "Observation method", "Acquisition"],
  "objective" => ["objective", "Objective", "Acquisition"],
  "zoom" => ["zoom", "Zoom", "Acquisition"],
  "exposureSetting" => ["exposure-setting", "Exposure", "Acquisition"],
  "sensitivity" => ["sensitivity", "Sensitivity", "Acquisition"],
  "brightfieldIllumination" => ["brightfield-illumination", "Brightfield illumination", "Illumination"],
  "darkfieldIllumination" => ["darkfield-illumination", "Darkfield illumination", "Illumination"],
  "obliqueDirection" => ["oblique-direction", "Oblique illumination", "Illumination"],
  "dicSettings" => ["dic-settings", "DIC settings", "Illumination"],
  "hdrMode" => ["hdr-mode", "HDR mode", "Image processing"],
  "gamma" => ["gamma", "Gamma", "Image processing"],
  "shadingCorrection" => ["shading-correction", "Shading correction", "Image processing"],
  "focusStack" => ["focus-stack", "Focus stack", "Image processing"],
  "stitching" => ["stitching", "Stitching", "Image processing"]
}.freeze

def fail_import(message)
  raise ImportError, message
end

def check_keys(object, allowed, context)
  fail_import("#{context} must be an object") unless object.is_a?(Hash)

  unknown = object.keys - allowed
  fail_import("#{context} contains unexpected keys: #{unknown.join(', ')}") unless unknown.empty?
end

def required_string(object, key, context)
  value = object[key]
  fail_import("#{context}.#{key} must be a non-empty string") unless value.is_a?(String) && !value.strip.empty?

  value.strip
end

def optional_string(object, key, context)
  value = object[key]
  return nil if value.nil?

  fail_import("#{context}.#{key} must be a string") unless value.is_a?(String)
  value.strip.empty? ? nil : value.strip
end

def safe_package_path(root, relative_path)
  fail_import("Asset path must be relative") if Pathname.new(relative_path).absolute?

  destination = File.expand_path(relative_path, root)
  prefix = File.expand_path(root) + File::SEPARATOR
  fail_import("Asset path escapes the export package") unless destination.start_with?(prefix)

  destination
end

def image_asset?(content_type, path)
  content_type.start_with?("image/") || IMAGE_EXTENSIONS.include?(File.extname(path).downcase)
end

def run_command(*command)
  output, status = Open3.capture2e(*command)
  fail_import("Command failed: #{command.join(' ')}\n#{output}") unless status.success?
  output
end

def convert_to_jpeg(source, destination)
  sips = "/usr/bin/sips"
  fail_import("The macOS sips image converter was not found") unless File.executable?(sips)

  FileUtils.mkdir_p(File.dirname(destination))
  JPEG_QUALITIES.each do |quality|
    FileUtils.rm_f(destination)
    run_command(
      sips,
      "-s", "format", "jpeg",
      "-s", "formatOptions", quality.to_s,
      "-Z", "1800",
      source,
      "--out", destination
    )
    break if File.size(destination) <= SAMPLE_LIBRARY_IMAGE_MAX_BYTES
  end
  if File.size(destination) > SAMPLE_LIBRARY_IMAGE_MAX_BYTES
    fail_import("Converted image exceeds the 1 MiB publication limit: #{source}")
  end

  dimensions = run_command(sips, "-g", "pixelWidth", "-g", "pixelHeight", destination)
  width = dimensions[/pixelWidth:\s+(\d+)/, 1]
  height = dimensions[/pixelHeight:\s+(\d+)/, 1]
  fail_import("Could not read converted image dimensions") unless width && height

  [width.to_i, height.to_i]
end

def humanize(value)
  value.split("-").map(&:capitalize).join(" ")
end

def deduplicate_assets(assets)
  seen = {}
  assets.each_with_object([]) do |asset, output|
    context = "asset #{asset['assetId']}"
    asset_id = required_string(asset, "assetId", context)
    signature = [
      required_string(asset, "packagePath", context),
      required_string(asset, "sha256", context).downcase,
      asset.fetch("sizeBytes")
    ]
    previous = seen[asset_id]
    if previous
      fail_import("Duplicate asset ID has conflicting file data: #{asset_id}") unless previous == signature
      next
    end

    seen[asset_id] = signature
    output << asset
  end
end

def write_sample_document(directory, manifest, sample, assets)
  fields = sample.fetch("fields")
  name = required_string(fields, "name", "sample fields")
  description = required_string(fields, "description", "sample fields")
  public_id = required_string(sample, "publicId", "sample")
  slug = public_id.downcase
  fail_import("Invalid public sample ID: #{public_id}") unless slug.match?(/\A[a-z0-9][a-z0-9-]*\z/)
  front_matter = {
    "layout" => "sample",
    "title" => name,
    "sample_id" => public_id,
    "permalink" => "/sample-library/#{slug}/",
    "description" => description,
    "material_class" => optional_string(fields, "materialClass", "sample fields"),
    "composition" => optional_string(fields, "composition", "sample fields"),
    "physical_form" => optional_string(fields, "physicalForm", "sample fields"),
    "provenance" => optional_string(fields, "provenance", "sample fields"),
    "preparation_notes" => optional_string(fields, "preparationNotes", "sample fields"),
    "handling_notes" => optional_string(fields, "handlingNotes", "sample fields"),
    "storage_requirements" => optional_string(fields, "storageRequirements", "sample fields"),
    "availability" => required_string(sample, "availability", "sample"),
    "specimens" => sample.fetch("specimens").map do |specimen|
      {
        "label_id" => required_string(specimen, "labelId", "specimen"),
        "status" => required_string(specimen, "status", "specimen"),
        "location" => required_string(specimen, "location", "specimen")
      }
    end,
    "assets" => assets,
    "source_updated_at" => required_string(sample, "updatedAt", "sample"),
    "publication_export_id" => manifest.fetch("exportId"),
    "publication_generated_at" => manifest.fetch("generatedAt")
  }.compact

  yaml = YAML.dump(front_matter).lines.drop(1).join
  File.write(File.join(directory, "#{slug}.md"), "---\n#{yaml}---\n")
end

def validate_manifest(manifest)
  check_keys(manifest, ROOT_KEYS, "manifest")
  schema_version = manifest["schemaVersion"]
  fail_import("Unsupported export schema") unless SUPPORTED_SCHEMA_VERSIONS.include?(schema_version)
  required_string(manifest, "exportId", "manifest")
  required_string(manifest, "generatedAt", "manifest")
  fail_import("manifest.samples must be an array") unless manifest["samples"].is_a?(Array)
  fail_import("The export contains no samples") if manifest["samples"].empty?

  manifest["samples"].each_with_index do |sample, sample_index|
    context = "sample #{sample_index + 1}"
    check_keys(sample, SAMPLE_KEYS.fetch(schema_version), context)
    required_string(sample, "publicId", context)
    required_string(sample, "updatedAt", context)
    required_string(sample, "availability", context)
    check_keys(sample["fields"], FIELD_KEYS, "#{context}.fields")
    required_string(sample["fields"], "name", "#{context}.fields")
    required_string(sample["fields"], "description", "#{context}.fields")
    fail_import("#{context}.specimens must be an array") unless sample["specimens"].is_a?(Array)
    fail_import("#{context}.assets must be an array") unless sample["assets"].is_a?(Array)
    sample["specimens"].each { |item| check_keys(item, SPECIMEN_KEYS, "#{context}.specimen") }
    sample["assets"].each do |asset|
      asset_context = "#{context}.asset"
      check_keys(asset, ASSET_KEYS.fetch(schema_version), asset_context)
      next unless schema_version == 3

      instrument = optional_string(asset, "instrument", asset_context)
      observation_mode = optional_string(asset, "observationMode", asset_context)
      field_width = optional_string(asset, "fieldWidth", asset_context)
      next unless observation_mode || field_width

      fail_import("#{asset_context} microscope metadata must include instrument, observationMode, and fieldWidth") unless instrument && observation_mode && field_width
      content_type = required_string(asset, "contentType", asset_context)
      package_path = required_string(asset, "packagePath", asset_context)
      fail_import("#{asset_context} microscope metadata must describe an image") unless image_asset?(content_type, package_path)
    end

    next unless schema_version == 2

    fail_import("#{context}.microscopy must be an array") unless sample["microscopy"].is_a?(Array)
    asset_ids = sample["assets"].to_h do |asset|
      [required_string(asset, "assetId", "#{context}.asset"), asset]
    end
    microscopy_asset_ids = []
    sample["microscopy"].each do |capture|
      capture_context = "#{context}.microscopy"
      check_keys(capture, MICROSCOPY_KEYS, capture_context)
      asset_id = required_string(capture, "assetId", capture_context)
      fail_import("#{capture_context}.assetId does not reference a public asset") unless asset_ids.key?(asset_id)
      fail_import("#{capture_context}.assetId is duplicated") if microscopy_asset_ids.include?(asset_id)

      microscopy_asset_ids << asset_id
      asset = asset_ids.fetch(asset_id)
      content_type = required_string(asset, "contentType", "#{context}.asset")
      package_path = required_string(asset, "packagePath", "#{context}.asset")
      fail_import("#{capture_context}.assetId must reference an image") unless image_asset?(content_type, package_path)

      fields = capture["fields"]
      check_keys(fields, MICROSCOPY_FIELD_DEFINITIONS.keys, "#{capture_context}.fields")
      published_field_count = MICROSCOPY_FIELD_DEFINITIONS.keys.count do |key|
        optional_string(fields, key, "#{capture_context}.fields")
      end
      fail_import("#{capture_context}.fields must contain a published value") if published_field_count.zero?
    end
  end
end

def validate_archive_entries(package)
  listing = run_command("unzip", "-Z1", package)
  listing.lines.each do |line|
    entry = line.strip
    next if entry.empty?

    path = Pathname.new(entry)
    clean = path.cleanpath.to_s
    fail_import("Unsafe path in export package: #{entry}") if path.absolute? || clean == ".." || clean.start_with?("../")
  end
end

def replace_targets(targets, backup_root)
  targets.each do |staged, destination, marker_required|
    next unless marker_required && File.exist?(destination)

    marker = File.join(destination, ".generated-by-sample-library-import")
    fail_import("Refusing to replace unmanaged directory: #{destination}") unless File.file?(marker)
  end

  backups = []
  installed = []
  begin
    targets.each_with_index do |(staged, destination, _marker_required), index|
      FileUtils.mkdir_p(File.dirname(destination))
      if File.exist?(destination)
        backup = File.join(backup_root, "target-#{index}")
        FileUtils.mv(destination, backup)
        backups << [backup, destination]
      end
      FileUtils.mv(staged, destination)
      installed << destination
    end
  rescue StandardError
    installed.reverse_each { |destination| FileUtils.rm_rf(destination) }
    backups.reverse_each { |backup, destination| FileUtils.mv(backup, destination) if File.exist?(backup) }
    raise
  end
end

package = ARGV.first
abort("Usage: script/import-sample-library PATH_TO_EXPORT.zip_OR_EXTRACTED_FOLDER") unless package
package = File.expand_path(package)
abort("Export package not found: #{package}") unless File.file?(package) || File.directory?(package)

stage_root = Dir.mktmpdir(".sample-library-import-", File.dirname(ROOT))
extract_root = File.directory?(package) ? package : File.join(stage_root, "extracted")
generated_samples = File.join(stage_root, "samples")
generated_assets = File.join(stage_root, "assets")
generated_data = File.join(stage_root, "sample-library-publication.yml")
backup_root = File.join(stage_root, "backups")

begin
  if File.file?(package)
    validate_archive_entries(package)
    FileUtils.mkdir_p(extract_root)
    run_command("unzip", "-qq", package, "-d", extract_root)
  end

  manifest_path = File.join(extract_root, "manifest.json")
  fail_import("The export package has no manifest.json") unless File.file?(manifest_path)
  manifest = JSON.parse(File.read(manifest_path))
  validate_manifest(manifest)

  FileUtils.mkdir_p(generated_samples)
  FileUtils.mkdir_p(generated_assets)
  File.write(File.join(generated_samples, ".generated-by-sample-library-import"), "#{manifest.fetch('exportId')}\n")
  File.write(File.join(generated_assets, ".generated-by-sample-library-import"), "#{manifest.fetch('exportId')}\n")

  manifest.fetch("samples").each do |sample|
    public_id = sample.fetch("publicId")
    slug = public_id.downcase
    sample_asset_directory = File.join(generated_assets, slug)
    FileUtils.mkdir_p(sample_asset_directory)

    public_assets = deduplicate_assets(sample.fetch("assets")).map do |asset|
      context = "asset #{asset['assetId']}"
      asset_id = required_string(asset, "assetId", context)
      package_path = required_string(asset, "packagePath", context)
      source = safe_package_path(extract_root, package_path)
      fail_import("Missing exported asset: #{package_path}") unless File.file?(source)

      expected_hash = required_string(asset, "sha256", context).downcase
      actual_hash = Digest::SHA256.file(source).hexdigest
      fail_import("Checksum mismatch for #{package_path}") unless actual_hash == expected_hash
      fail_import("File size mismatch for #{package_path}") unless File.size(source) == asset.fetch("sizeBytes")

      content_type = required_string(asset, "contentType", context)
      kind = required_string(asset, "kind", context)
      caption = required_string(asset, "caption", context)
      instrument = optional_string(asset, "instrument", context)
      observation_mode = optional_string(asset, "observationMode", context)
      field_width = optional_string(asset, "fieldWidth", context)

      if image_asset?(content_type, source)
        filename = "#{asset_id}.jpg"
        destination = File.join(sample_asset_directory, filename)
        width, height = convert_to_jpeg(source, destination)
        {
          "asset_id" => asset_id,
          "url" => "/assets/sample-library/#{slug}/#{filename}",
          "kind" => kind,
          "kind_label" => humanize(kind),
          "caption" => caption,
          "instrument" => instrument,
          "observation_mode" => observation_mode,
          "field_width" => field_width,
          "is_image" => true,
          "content_type" => "image/jpeg",
          "width" => width,
          "height" => height
        }.compact
      else
        extension = File.extname(package_path).downcase
        fail_import("Unsafe asset extension: #{extension}") unless extension.match?(/\A\.[a-z0-9]{1,10}\z/)
        filename = "#{asset_id}#{extension}"
        FileUtils.cp(source, File.join(sample_asset_directory, filename))
        {
          "asset_id" => asset_id,
          "url" => "/assets/sample-library/#{slug}/#{filename}",
          "kind" => kind,
          "kind_label" => humanize(kind),
          "caption" => caption,
          "instrument" => instrument,
          "is_image" => false,
          "content_type" => content_type
        }.compact
      end
    end

    write_sample_document(generated_samples, manifest, sample, public_assets)
  end

  File.write(
    generated_data,
    YAML.dump(
      "schema_version" => manifest.fetch("schemaVersion"),
      "export_id" => manifest.fetch("exportId"),
      "generated_at" => manifest.fetch("generatedAt"),
      "sample_count" => manifest.fetch("samples").size
    )
  )

  FileUtils.mkdir_p(backup_root)
  replace_targets(
    [
      [generated_samples, File.join(ROOT, "_samples"), true],
      [generated_assets, File.join(ROOT, "assets", "sample-library"), true],
      [generated_data, File.join(ROOT, "_data", "sample-library-publication.yml"), false]
    ],
    backup_root
  )

  puts "Imported #{manifest.fetch('samples').size} samples from #{manifest.fetch('exportId')}."
  puts "Run bundle exec jekyll build and review the generated sample pages before committing."
rescue ImportError, JSON::ParserError, KeyError => e
  warn "Sample-library import failed: #{e.message}"
  exit 1
ensure
  FileUtils.rm_rf(stage_root)
end
