#!/usr/bin/env ruby
# frozen_string_literal: true

require "w3c_validators"
require "pathname"

def validator(file)
  extension = File.extname(file)
  if extension == ".html"
    W3CValidators::NuValidator.new
  elsif extension == ".css"
    W3CValidators::CSSValidator.new
  end
end

def validate(file)
  puts "Checking #{file}..."

  path = File.expand_path "../_site/#{file}", __dir__
  results = validator(file).validate_file(path)

  return puts "Valid!" if results.errors.empty?

  results.errors.each { |err| puts err.to_s }
  exit 1
end

validate "index.html"
validate File.join "instruments", "ftir.html"
validate File.join "instruments", "optical.html"
validate File.join "instruments", "psa.html"
validate File.join "quick-guides", "ftir", "index.html"
validate File.join "quick-guides", "optical", "index.html"
validate "sample-library.html"
Dir.glob(File.expand_path("../_site/sample-library/*/index.html", __dir__))
  .sort
  .each { |path| validate Pathname.new(path).relative_path_from(Pathname.new(File.expand_path("../_site", __dir__))).to_s }
validate File.join "assets", "css", "style.css"
